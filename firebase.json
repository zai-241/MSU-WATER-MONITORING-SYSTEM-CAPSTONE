{
  "hosting": {
    "site": "msu-water-monitoring-system",
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": {
    "rules": "backend/cloud/database.rules.json"
  },
  "firestore": {
    "rules": "backend/cloud/firestore.rules"
  }
}